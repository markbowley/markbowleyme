---
// Dev-only preview of drafts in src/content/drafts, using the live post layout.
// In production builds no paths are generated, so drafts never ship.
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	if (!import.meta.env.DEV) return [];
	const drafts = await getCollection('drafts');
	return drafts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data}>
	<Content />
</BlogPost>
